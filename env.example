# Copy to .env, fill in what you have, then: chmod 600 .env
# Shadowcrumbs loads it at start. A variable already set in your shell wins. .env is gitignored.
# Anything left blank is skipped. Never commit real keys. Full walkthrough: docs/API-KEYS.md

# Brave Search API: the reliable search engine, leads the fallback chain when set.
# Get it: https://brave.com/search/api/
BRAVE_API_KEY=

# GitHub fine-grained token: public repositories, read-only, no extra permissions. Powers github_code_search.
# Get it: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# urlscan.io: works without a key, a key raises your limits.
# Get it: https://urlscan.io/user/profile/
URLSCAN_API_KEY=

# Have I Been Pwned (paid). Get it: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# DeHashed (paid, each search uses a credit). Get it: https://app.dehashed.com/
DEHASHED_API_KEY=
