# Copy to .env, fill in what you have, then: chmod 600 .env
# Shadowcrumbs loads it at start. A variable already set in your shell wins. .env is gitignored.
# Anything left blank is skipped. Never commit real keys.

# Brave Search API: the reliable search engine. Leads the fallback chain when set.
BRAVE_API_KEY=
# GitHub fine-grained token: public repositories, read-only, no extra permissions. Powers github_code_search.
GITHUB_TOKEN=
# Optional
HIBP_API_KEY=
DEHASHED_API_KEY=
URLSCAN_API_KEY=
